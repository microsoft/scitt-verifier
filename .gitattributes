* text=auto eol=lf

# Conformance fixtures are exact bytes from a transparency service. Any
# transformation changes the digests the test suite pins.
*.cose  binary
*.cbor  binary
*.bin   binary

# Hash-envelope binding fixtures are hashed byte-for-byte by the test suite.
# They are JSON, so `text=auto` would otherwise normalise their line endings
# and silently change every digest computed from them.
corpus/fixtures/*.spdx.json  binary
